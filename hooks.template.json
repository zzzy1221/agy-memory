{
  "_comment": "Template. Do not edit by hand: `node scripts/install.js` generates the real hooks.json next to this file, using your machine's absolute paths.",
  "agy-memory-session": {
    "SessionStart": [
      {
        "type": "command",
        "command": "<PLUGIN_ROOT>/scripts/hook.cmd SessionStart",
        "timeout": 15
      }
    ]
  },
  "agy-memory-recall": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "<PLUGIN_ROOT>/scripts/hook.cmd PreInvocation",
        "timeout": 10
      }
    ]
  }
}
